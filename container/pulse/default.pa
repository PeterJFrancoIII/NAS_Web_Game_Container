# Minimal PulseAudio graph for RA2 browser audio.

.fail
load-module module-native-protocol-unix auth-anonymous=1 socket=/tmp/pulse/native

load-module module-null-sink sink_name=game sink_properties=device.description=RA2_Game_Audio
set-default-sink game

load-module module-simple-protocol-tcp listen=127.0.0.1 port=4711 format=s16le channels=2 rate=44100 record=true playback=false
